                          <Lock className="w-5 h-5 text-gray-500" />
                        ) : null}
                      </div>
                      <h3 className="font-semibold text-white mb-1">{level.title}</h3>
                      <p className="text-xs text-gray-400 line-clamp-2">{level.category}</p>
                    </button>
                  );
