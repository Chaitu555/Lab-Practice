                <p className="text-blue-200 text-sm">{currentLevelData.realWorld}</p>
              </div>
              
              <p className="text-gray-300 mb-4">{currentLevelData.description}</p>
              
              <div className="bg-green-900/30 border-l-4 border-green-500 p-4 rounded-r-lg">
                <h3 className="font-semibold text-green-300 mb-2">Task:</h3>
                <p className="text-green-200">{currentLevelData.task}</p>
              </div>
            </div>

            <div className="mb-6">
              <button
                onClick={() => setShowExplanation(!showExplanation)}
                className="flex items-center space-x-2 text-purple-400 hover:text-purple-300 transition-colors mb-3"
              >
                <Code2 className="w-5 h-5" />
                <span className="font-medium">
                  {showExplanation ? 'Hide Detailed Explanation' : 'Show Why & How This Works'}
                </span>
              </button>
              
              {showExplanation && (
                <div className="bg-purple-900/30 border-l-4 border-purple-500 p-4 rounded-r-lg">
                  <pre className="text-purple-200 text-sm whitespace-pre-wrap font-sans">{currentLevelData.explanation}</pre>
                </div>
              )}
            </div>

            <div className="mb-6">
              <button
                onClick={() => setShowHint(!showHint)}
                className="flex items-center space-x-2 text-yellow-400 hover:text-yellow-300 transition-colors"
              >
                <Lightbulb className="w-5 h-5" />
                <span className="font-medium">
                  {showHint ? 'Hide Hint' : 'Show Hint'}
                </span>
              </button>
              
              {showHint && (
                <div className="mt-3 bg-yellow-900/30 border-l-4 border-yellow-400 p-4 rounded-r-lg">
                  <pre className="text-yellow-200 text-sm whitespace-pre-wrap font-mono">{currentLevelData.hint}</pre>
                </div>
              )}
            </div>

            {feedback && (
              <div className={`p-4 rounded-lg mb-6 ${
                feedback.type === 'success' 
                  ? 'bg-green-900/30 border border-green-500' 
                  : 'bg-red-900/30 border border-red-500'
              }`}>
                <p className={`font-medium mb-2 ${
                  feedback.type === 'success' 
                    ? 'text-green-300' 
                    : 'text-red-300'
                }`}>
                  {feedback.message}
                </p>
                
                {feedback.output && (
                  <div className="mb-2">
                    <p className="text-sm text-gray-300 mb-1">Your output:</p>
                    <pre className="bg-slate-900 p-2 rounded text-sm font-mono text-gray-200">{feedback.output}</pre>
                  </div>
                )}
                
                {feedback.expected && (
                  <div className="mb-2">
                    <p className="text-sm text-gray-300 mb-1">Expected output:</p>
                    <pre className="bg-slate-900 p-2 rounded text-sm font-mono text-gray-200">{feedback.expected}</pre>
                  </div>
                )}
              </div>
            )}
          </div>

          <div className="bg-slate-800 rounded-xl shadow-lg overflow-hidden">
            <div className="bg-slate-900 text-white p-4 flex items-center justify-between">
              <div className="flex items-center space-x-2">
                <Terminal className="w-5 h-5 text-green-400" />
                <h3 className="font-semibold">Python Code Editor</h3>
              </div>
              <div className="flex items-center space-x-2">
                <button
                  onClick={handleReset}
                  className="flex items-center space-x-1 bg-slate-700 hover:bg-slate-600 px-3 py-1 rounded transition-colors text-sm"
                >
                  <RotateCcw className="w-4 h-4" />
                  <span>Reset</span>
                </button>
                <button
                  onClick={handleSubmit}
                  className="flex items-center space-x-1 bg-green-600 hover:bg-green-500 px-3 py-1 rounded transition-colors text-sm"
                >
                  <Play className="w-4 h-4" />
                  <span>Run Code</span>
                </button>
              </div>
            </div>
            
            <div className="p-0">
              <textarea
                value={userCode}
                onChange={(e) => setUserCode(e.target.value)}
                className="w-full h-96 p-4 font-mono text-sm bg-slate-900 text-green-400 border-0 resize-none focus:outline-none focus:ring-0"
                placeholder="# Write your Python code here..."
                spellCheck={false}
              />
            </div>
          </div>
        </div>

        <div className="mt-8 flex justify-between items-center">
          <button
            onClick={() => currentLevel > 1 && handleLevelChange(currentLevel - 1)}
            disabled={currentLevel === 1}
            className="px-6 py-3 bg-slate-700 text-white rounded-lg hover:bg-slate-600 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
          >
            Previous Level
          </button>
          
          <div className="text-center">
            <p className="text-gray-300">
              Level {currentLevel} of {levels.length}
            </p>
          </div>
          
          <button
            onClick={() => {
              if (completedLevels.has(currentLevel) && currentLevel < levels.length) {
                handleLevelChange(currentLevel + 1);
              }
            }}
            disabled={!completedLevels.has(currentLevel) || currentLevel === levels.length}
            className="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
          >
            Next Level
          </button>
        </div>
      </main>
    </div>
  );
};

export default DevOpsPythonLearning;
